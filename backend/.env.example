# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000

# Optional: without this, StockPulse runs on a simulated real-time price feed.
# Get a free key at https://polygon.io/dashboard/signup
# Note: real-time US stock WebSocket data requires a paid Polygon.io plan;
# the free tier only covers REST ticker search + delayed data.
POLYGON_API_KEY=

# SQLite connection string used by Prisma
DATABASE_URL="file:./prisma/dev.db"

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
