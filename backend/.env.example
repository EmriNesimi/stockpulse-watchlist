# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000

# Optional: without this, StockPulse runs on a simulated real-time price feed.
# Get a free key at https://massive.com (Massive is the market-data provider
# formerly branded Polygon.io — same account/API, renamed Oct 2025).
# Free-tier accounts are capped at 5 REST calls/min and don't include
# real-time US stock WebSocket trades; the app respects both limits
# automatically (rate-limits outbound calls and falls back to simulated
# prices if the WS feed isn't entitled).
MASSIVE_API_KEY=

# SQLite connection string used by Prisma
DATABASE_URL="file:./prisma/dev.db"

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
