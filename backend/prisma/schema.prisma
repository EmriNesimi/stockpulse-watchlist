generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The url moved to prisma.config.ts in Prisma 7; the runtime client uses a
  // driver adapter instead of a connection string (see src/db.ts).
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  passwordHash             String
  createdAt                DateTime  @default(now())
  // Signup doesn't block on verification - the account works immediately,
  // this just tracks whether the email's been confirmed yet for the banner/
  // resend flow. Token is a single-use random value, cleared on verify.
  emailVerifiedAt          DateTime?
  verificationToken        String?   @unique
  verificationTokenExpires DateTime?
}

// userId isn't a Prisma relation to User.id on purpose - it's kept as a
// loose string like it always was, just without the "default-user"
// fallback now that every watchlist belongs to a real signed-up user.
model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  createdAt DateTime        @default(now())
  items     WatchlistItem[]
  alerts    PriceAlert[]

  @@unique([userId])
}

model WatchlistItem {
  id          String    @id @default(cuid())
  symbol      String
  name        String?
  addedAt     DateTime  @default(now())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  // Both null by default - most items are just "watching", not "owning".
  // Both get set together or not at all (enforced at the zod boundary, not
  // here) so profit/loss is always computable from real numbers a user
  // actually entered, never a partial or fabricated figure.
  shares      Float?
  costBasis   Float? // price per share paid, in dollars

  @@unique([watchlistId, symbol])
  @@index([watchlistId])
}

// One-shot price alerts: "notify me when AAPL crosses $200". Fires once
// when the price crosses the threshold in the given direction, then stays
// triggered — it doesn't re-fire on every subsequent tick above/below it.
model PriceAlert {
  id          String    @id @default(cuid())
  symbol      String
  threshold   Float
  direction   String // "above" | "below" — enforced by zod at the API boundary, not the db
  createdAt   DateTime  @default(now())
  triggeredAt DateTime?
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@index([watchlistId])
  @@index([symbol])
}
