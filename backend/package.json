{
  "name": "stockpulse-backend",
  "version": "0.1.0",
  "private": true,
  "description": "StockPulse backend — Express REST API, WebSocket price broadcaster, Prisma/SQLite persistence, Massive integration",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.2",
    "express-rate-limit": "7.4.1",
    "helmet": "7.1.0",
    "ws": "8.21.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.16.11",
    "@types/ws": "8.5.12",
    "prisma": "5.20.0",
    "tsx": "4.23.1",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
