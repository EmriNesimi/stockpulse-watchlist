{
  "name": "stockpulse-backend",
  "version": "0.1.0",
  "private": true,
  "description": "StockPulse backend — Express REST API, WebSocket price broadcaster, Prisma/SQLite persistence, Massive integration",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.3.0",
    "ws": "8.21.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "prisma": "^7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "5.6.3",
    "vitest": "3.2.7"
  }
}
