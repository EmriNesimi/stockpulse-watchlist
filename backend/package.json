{
  "name": "stockpulse-backend",
  "version": "0.1.0",
  "private": true,
  "description": "StockPulse backend — Express REST API, WebSocket price broadcaster, Prisma/Postgres persistence, Massive integration",
  "main": "dist/server.js",
  "engines": {
    "node": "^20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "ws": "8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "prisma": "^7.9.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  }
}
