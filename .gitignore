# Dependencies
node_modules/

# Env / secrets — no .env files at all in this repo, not even an example
# template, to keep the risk surface at zero.
.env
.env.*
*.env
backend/.env
backend/.env.*

# Database. Nothing writes a .db file since the move to Postgres; kept as a
# backstop alongside the same check in CI, because one committed by
# accident would carry real emails and password hashes.
*.db

# Build output
dist/
build/
frontend/dist/
backend/dist/

*.tsbuildinfo

# Logs
npm-debug.log*
*.log

# OS
.DS_Store

# Editor / tooling
.vscode/
.idea/
.serena/

# Database dumps — these contain real user emails and password hashes.
# Never commit one.
backups/
*.sql.gz
